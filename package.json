{
	"name": "percs.dev",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm run build:client && pnpm run build:server && node prerender.js",
		"build:client": "tsc && vite build --ssrManifest .vite/ssr-manifest.json --outDir dist/static",
		"build:server": "tsc && vite build --ssr src/main-server.ts --outDir dist/server",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@literals/rollup-plugin-html-css-minifier": "^4.0.2",
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"dreamland": "github:MercuryWorkshop/dreamlandjs"
	}
}
